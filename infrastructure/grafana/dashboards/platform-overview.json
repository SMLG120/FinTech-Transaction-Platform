          "editorMode": "code",
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"platform-services\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"platform-services\"}[$__rate_interval])), 0.000001)",
