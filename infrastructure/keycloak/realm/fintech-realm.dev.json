{
  "realm": "fintech",
  "displayName": "FinTech Platform (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and maxLength(128) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 1800,
  "ssoSessionMaxLifespanRememberMe": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en"
  ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "PLATFORM_ADMIN",
        "description": "Operates the platform. Not a business role, and deliberately distinct from any role that moves money."
      },
      {
        "name": "CUSTOMER",
        "description": "The authenticated owner of an account. May act only on their own resources, which is enforced per resource in later phases."
      },
      {
        "name": "SUPPORT_AGENT",
        "description": "Handles customer enquiries. Read access to customer context; cannot move money."
      },
      {
        "name": "COMPLIANCE_OFFICER",
        "description": "Reviews regulatory obligations and can approve or block where policy requires it."
      },
      {
        "name": "AUDITOR",
        "description": "Read-only access to the audit trail. No write access to any domain."
      },
      {
        "name": "FRAUD_ANALYST",
        "description": "Works the fraud alert queue: claims alerts, closes them, re-scores payments and overrules scores up to the configured cap. Separate from COMPLIANCE_OFFICER, who supervises without working it."
      },
      {
        "name": "SETTLEMENT_OPERATOR",
        "description": "Closes settlement cycles, declares an actual for a period, and works reconciliation breaks. Separate from the reader roles (AUDITOR, COMPLIANCE_OFFICER) on purpose: an auditor who could close a period could stop being one."
      }
    ]
  },
  "clients": [
    {
      "clientId": "fintech-api",
      "name": "FinTech Platform API",
      "description": "The resource server identity. Present in the token's aud claim so a token minted for a different client cannot be replayed against this API.",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "300"
      },
      "fullScopeAllowed": true
    },
    {
      "clientId": "fintech-web",
      "name": "FinTech Web (browser sign-in)",
      "description": "Public browser client for both UIs. Authorization Code + PKCE (S256) only: no password grant, no implicit flow, no offline tokens, exact redirect URIs. Scripts use fintech-cli instead.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "",
      "baseUrl": "",
      "adminUrl": "",
      "redirectUris": [
        "http://localhost:3001/",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:5173"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300",
        "post.logout.redirect.uris": "http://localhost:3001/##http://localhost:5173/login",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "require.pushed.authorization.requests": "false",
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "fintech-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fintech-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "roles",
        "web-origins",
        "profile",
        "email",
        "acr",
        "basic"
      ],
      "implicitFlowEnabled": false
    },
    {
      "clientId": "fintech-cli",
      "name": "FinTech CLI (local development only)",
      "description": "Dev-only public client for scripts/get-token.sh and the verify scripts. Password grant only, no browser flows, no web origins. Must not exist in any deployed realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "rootUrl": "",
      "baseUrl": "",
      "adminUrl": "",
      "redirectUris": [],
      "webOrigins": [],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "300",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "require.pushed.authorization.requests": "false"
      },
      "protocolMappers": [
        {
          "name": "fintech-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fintech-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "roles",
        "web-origins",
        "profile",
        "email",
        "acr",
        "basic"
      ],
      "implicitFlowEnabled": false
    },
    {
      "clientId": "fintech-registration",
      "name": "Customer self-registration (auth-service)",
      "description": "Confidential client used only by auth-service to create CUSTOMER users. Service account only: no browser flow, no password grant. Its secret is injected at import from KEYCLOAK_ADMIN_CLIENT_SECRET and never committed.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "access.token.lifespan": "60"
      },
      "fullScopeAllowed": false
    }
  ],
