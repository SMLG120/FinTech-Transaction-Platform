# ---------------------------------------------------------------------------
# Local development environment. Copy to .env and keep .env out of git.
#
#   ./scripts/bootstrap.sh        # generates .env with fresh random secrets
#
# NOTHING IN THIS FILE IS A REAL SECRET. Every value here is either a
# non-secret local default or a placeholder that bootstrap.sh replaces with a
# randomly generated value. The committed .env.example must never contain a
# credential that also works anywhere else.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- identity
# Local-only Keycloak realm. The realm itself is version controlled at
# infrastructure/keycloak/realm/fintech-realm.dev.json and imported on startup,
# so the roles, clients and test users are reviewable in a diff rather than
# existing only in someone's browser.
KEYCLOAK_REALM=fintech
KEYCLOAK_ADMIN_USERNAME=admin
# Placeholder -> replaced by bootstrap.sh with a random value.
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# The audience a token must carry to be accepted by the platform API. This is the
# client id of the API's own client in the realm, and the reason a token minted for
# some other client in this Keycloak cannot be replayed against these services.
KEYCLOAK_API_AUDIENCE=fintech-api

# Signs the identity the gateway forwards to downstream services (ADR-0004).
# Placeholder -> replaced by bootstrap.sh with a random value.
#
# This key exists because mutual TLS between services is a Phase 15 item. Until a
# service is only reachable over an authenticated connection, an unsigned identity
# header is forgeable by anything that can open a socket, so the gateway signs it
# and services verify the signature. It is a local stand-in, not the production
# mechanism, and it disappears when mTLS lands.
INTERNAL_IDENTITY_SIGNING_KEY=CHANGE_ME

# Encrypts customer PII at rest (Phase 3). customer-service derives a separate AES-256 key per
# customer from this master key using HKDF, keyed on the Keycloak subject, and never stores that
# derived key. Erasing a customer removes the subject, which removes the only input needed to derive
# the key, which makes the retained ciphertext permanently unreadable even by someone holding this
# value.
#
# Must be base64 of exactly 32 bytes; customer-service refuses to start otherwise rather than fall
# back to something weaker. Placeholder -> replaced by bootstrap.sh with a random value.
#
# Losing this value means losing every PII column in the platform. It is deliberately NOT a password:
# the same secret keys both the blind indexes and the derivation, so it needs a secret manager and
# versioned retention in any real deployment.
CUSTOMER_PII_MASTER_KEY=CHANGE_ME
# Stamped into every ciphertext. Bump only as part of a rotation that re-encrypts existing rows;
# see docs/security.md.
CUSTOMER_PII_KEY_VERSION=1

# Tokenises card numbers (Phase 4). card-service mints a synthetic PAN, derives a token from it as
# HMAC-SHA256 under this key, and stores only the token. The number exists in the issuing process for
# the length of one method call and is never written anywhere, so this database is not a card vault.
#
# A deliberate second secret rather than a second use of CUSTOMER_PII_MASTER_KEY. The PII key
# protects data the platform must be able to read back to run identity checks; this one derives a
# value the platform must never be able to invert. Sharing a key would make a compromise of the PII
# vault also compromise every card, and would tie two unrelated rotation cadences together.
#
# Must be base64 of exactly 32 bytes; card-service refuses to start otherwise. Rotating it
# invalidates every existing token, so it is a coordinated migration, not a config push: see
# docs/decisions/0006-card-tokenisation.md.
CARD_TOKENISATION_KEY=CHANGE_ME

# Derives subject digests in transaction-service (Phase 5). The gateway verifies who is calling and
# passes the subject; this service stores HMAC-SHA256(subject) under this key against every payment and
# every ledger account, so the raw Keycloak subject never reaches the database.
#
# A third distinct secret, and the isolation this one buys is the whole of ADR-0002. customer-service
# and card-service each hold a subject digest of their own, computed under their own keys, so joining
# the three databases cannot correlate a subject across them. That property lives *entirely* in these
# keys being different. Hand any service another service's key and the join starts working with no
# error anywhere to notice it: both columns look like plausible digests and the correlation succeeds.
#
# Must be base64 of at least 32 bytes; transaction-service refuses to start otherwise, deliberately and
# with no default, because a service running on a key that came from this file is not running on a
# secret. Rotating it does NOT invalidate any token, but it does orphan every account and payment row
# already written under the old digest — a customer's balance becomes unreachable. Rotate it before
# there is data, never after; see docs/security.md.
SUBJECT_DIGEST_KEY=CHANGE_ME

# Card product policy, not secrets. Both have working defaults in application.yml and are listed
# here so an operator can see every knob in one place.
CARD_VALIDITY_MONTHS=36
CARD_MAX_PER_CUSTOMER=5

# ---------------------------------------------------------------- database
# The Postgres superuser for the container's own bootstrap (creates databases
# and roles). Not used by the application.
POSTGRES_SUPERUSER=fintech_root
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

# The password every service role is created with. One generated value for local
# convenience, because the isolation that matters comes from the roles being
# separate (see infrastructure/docker/postgres/init/01-create-databases.sh), not
# from the password. In Kubernetes each role gets its own secret so that
# revoking one service cannot be undone by knowing the others' credentials.
#
# Each service's username is its own role name, set explicitly per service in
# docker-compose.yml. There is no single shared application username, because a
# shared role would make every service able to read every other service's data.
SERVICE_DB_PASSWORD=CHANGE_ME

# Overrides only for a laptop run outside Docker. Inside Compose the URL is
# derived per service from the database name.
#
# LOCAL_DB_PORT is the host port Postgres is published on, not the container port. Change it if
# something local already listens on 5432 -- a native Postgres install is the usual culprit -- so
# the stack does not have to give up its place to whatever is already running.
LOCAL_DB_PORT=5432
LOCAL_DB_HOST=localhost

# ---------------------------------------------------------------- redis
REDIS_PORT=6379
# Redis requires a password even locally. It is trivial to set, and a stack that
# is already wired for an authenticated Redis is one step closer to the deployed
# configuration than one that silently runs unauthenticated.
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8081
# Single-broker KRaft controller quorum for local dev.
KAFKA_NODE_ID=1
KAFKA_CLUSTER_ID=fint3ch-l0cal-Kr4ft-0neBr0ker

# ---------------------------------------------------------------- observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- platform
APP_ENVIRONMENT=local
APP_VERSION=0.1.0-SNAPSHOT
# ECS | logstash | gelf | (empty for the human-readable pattern)
LOG_FORMAT=ecs
LOG_LEVEL_PLATFORM=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_KAFKA=WARN
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
KAFKA_CONCURRENCY=3

# ---------------------------------------------------------------- build
# Set to 1 to have docker compose build with no cache (used by `make rebuild`).
BUILD_NO_CACHE=0
