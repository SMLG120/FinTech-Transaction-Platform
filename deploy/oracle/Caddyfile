# Oracle edge: four public hostnames, with Let's Encrypt certificates that Caddy obtains and renews
# itself. Only these hosts are reachable from the internet; Grafana, Prometheus, Kafka UI and every
# service port stay bound to the VM's loopback (reach them with an SSH tunnel).
# Routes and their filtering live in deploy/edge.caddy, shared with the other targets.

{
	# No admin API on the network.
	admin off
}

import /etc/caddy/edge.caddy

app.{$PUBLIC_DOMAIN} {
	import app
}

dash.{$PUBLIC_DOMAIN} {
	import dash
}

api.{$PUBLIC_DOMAIN} {
	import api
}

auth.{$PUBLIC_DOMAIN} {
	import auth
}
